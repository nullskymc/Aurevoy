# Aurevoy 环境变量示例（仅运维 / 进程面）
# 放在 monorepo 根目录；复制为 .env 后按需修改（已 gitignore）。
#
# 产品配置（LLM / MCP / 搜索 / embedding / 预算 / 沙箱开关等）
# 一律在 App 设置页配置，写入 SQLite，不要放进 env。
#
# 默认数据路径：
#   数据库  ~/.aurevoy/aurevoy.sqlite
#   工作区  ~/.aurevoy/workspace
#   日志    ~/.aurevoy/logs/aurevoy.log

# ── 服务 ─────────────────────────────────────────────
# AUREVOY_HOST=127.0.0.1
# AUREVOY_PORT=8787
# AUREVOY_CORS_ORIGINS=*

# ── 路径（开发期可改相对路径）────────────────────────
# AUREVOY_DB_PATH=./aurevoy.sqlite
# AUREVOY_WORKSPACE_DIR=./workspace

# ── 日志 ─────────────────────────────────────────────
# AUREVOY_LOG_LEVEL=info
# AUREVOY_LOG_FILE=
# AUREVOY_LOG_PRETTY=true
