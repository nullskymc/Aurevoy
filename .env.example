# Aurevoy 环境变量示例
# 放在 monorepo 根目录；复制为 .env 后按需修改
# （根目录 .env 已在 .gitignore 中，不会提交）。
# Agent 引擎启动时会从项目根目录加载本文件。
#
# 安装版默认值：
#   - 数据库：  ~/.aurevoy/aurevoy.sqlite
#   - 工作区：  ~/.aurevoy/workspace
#   - 日志：    ~/.aurevoy/logs/aurevoy.log
#   - Skills：  ~/.aurevoy/skills
# 开发期如需使用安装版同级路径，注释掉下面的 DB_PATH/WORKSPACE_DIR 覆盖即可。

# ── 服务 ─────────────────────────────────────────────
# AUREVOY_HOST=127.0.0.1
# AUREVOY_PORT=8787
# 开发期使用相对路径（安装版自动指向 ~/.aurevoy/）
# AUREVOY_DB_PATH=./aurevoy.sqlite
# 工具工作区根目录：文件类工具(read_file/write_file/list_directory)的路径都被限制在此目录内
# AUREVOY_WORKSPACE_DIR=./workspace
# 单轮 LLM 调用超时(毫秒)
# AUREVOY_LLM_TIMEOUT_MS=120000
# 等待用户审批的超时(毫秒)
# AUREVOY_APPROVAL_TIMEOUT_MS=300000
# 允许的前端来源，逗号分隔；开发期可用 * 放开
# AUREVOY_CORS_ORIGINS=*

# ── LLM Provider（必填）────────────────────────────────
# Aurevoy 使用 OpenAI 兼容协议，支持 OpenAI / DeepSeek / Moonshot /
# 本地 Ollama(/v1) / vLLM / LM Studio 等。
# 未配置 API Key 时，执行任务会明确报错（不再有占位/Mock 回退）。

AUREVOY_LLM_PROVIDER=openai
AUREVOY_LLM_API_KEY=
AUREVOY_LLM_BASE_URL=https://api.openai.com/v1
AUREVOY_LLM_MODEL=gpt-4o-mini
# AUREVOY_LLM_TEMPERATURE=0.7

# DeepSeek 示例
# AUREVOY_LLM_BASE_URL=https://api.deepseek.com/v1
# AUREVOY_LLM_MODEL=deepseek-chat

# 本地 Ollama 示例（需开启 OpenAI 兼容端点；Key 可填任意非空值）
# AUREVOY_LLM_API_KEY=ollama
# AUREVOY_LLM_BASE_URL=http://127.0.0.1:11434/v1
# AUREVOY_LLM_MODEL=llama3.1

# ── MCP servers（可选）────────────────────────────────
# 启动时连接 MCP server，把其 tools 注册进 Aurevoy 工具注册表。
# 支持 JSON 数组、单个对象、对象映射，以及 Claude Desktop 风格的 {"mcpServers":{...}}。
# MCP 工具名会自动转为 mcp_<server>_<tool>，并复用现有审批模型：
# - riskLevel 可填 safe/caution/dangerous；不填时按 MCP annotations 推断，兜底 caution。
# - env 写在 .env 中，禁止把真实密钥提交到仓库。
#
# AUREVOY_MCP_SERVERS_JSON={"mcpServers":{"localTools":{"command":"node","args":["./mcp/local-tools-server.js"],"riskLevel":"caution"}}}

# ── 沙箱 / 高风险执行（默认关闭）────────────────────────
# 命令/代码执行尚未作为工具开放；该开关只用于未来显式启用隔离执行器。
# 默认 false，不能为了“看起来可用”而打开未接入审批/轨迹/回归的 shell。
# AUREVOY_ENABLE_COMMAND_EXECUTION=false
# AUREVOY_COMMAND_TIMEOUT_MS=30000
# AUREVOY_COMMAND_OUTPUT_LIMIT_BYTES=65536
# AUREVOY_COMMAND_ENV_ALLOWLIST=PATH,HOME,TMPDIR
