# Aurevoy 环境变量示例
# 放在 monorepo 根目录；复制为 .env 后按需修改
# （根目录 .env 已在 .gitignore 中，不会提交）。
# Agent 引擎启动时会从项目根目录加载本文件。

# ── 服务 ─────────────────────────────────────────────
# AUREVOY_HOST=127.0.0.1
# AUREVOY_PORT=8787
# AUREVOY_DB_PATH=./aurevoy.sqlite
# 允许的前端来源，逗号分隔；开发期可用 * 放开
# AUREVOY_CORS_ORIGINS=*

# ── LLM Provider ────────────────────────────────────
# provider 取值：
#   mock    —— 默认，无需 Key，离线占位回复，用于开发期跑通链路
#   openai  —— OpenAI 兼容协议（OpenAI / DeepSeek / Moonshot / 本地 Ollama 等）
# 缺少 AUREVOY_LLM_API_KEY 时会自动回退到 mock。
AUREVOY_LLM_PROVIDER=mock

# OpenAI 官方
# AUREVOY_LLM_PROVIDER=openai
# AUREVOY_LLM_API_KEY=sk-xxxxxxxx
# AUREVOY_LLM_BASE_URL=https://api.openai.com/v1
# AUREVOY_LLM_MODEL=gpt-4o-mini

# DeepSeek 示例
# AUREVOY_LLM_PROVIDER=openai
# AUREVOY_LLM_API_KEY=sk-xxxxxxxx
# AUREVOY_LLM_BASE_URL=https://api.deepseek.com/v1
# AUREVOY_LLM_MODEL=deepseek-chat

# 本地 Ollama 示例（需开启 OpenAI 兼容端点，无需真实 Key）
# AUREVOY_LLM_PROVIDER=openai
# AUREVOY_LLM_API_KEY=ollama
# AUREVOY_LLM_BASE_URL=http://127.0.0.1:11434/v1
# AUREVOY_LLM_MODEL=llama3.1

# 采样温度
# AUREVOY_LLM_TEMPERATURE=0.7
