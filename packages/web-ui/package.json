{
  "name": "@aurevoy/web-ui",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "dev": "concurrently -n lib,types -c cyan,magenta \"vite build --config vite.lib.config.ts --watch\" \"tsc -p tsconfig.build.json --watch\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "vite build",
    "dev:web": "vite"
  },
  "dependencies": {
    "@aurevoy/shared": "*",
    "dompurify": "3.4.8",
    "framer-motion": "^11.18.2",
    "highlight.js": "11.11.1",
    "marked": "18.0.5",
    "marked-highlight": "2.2.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.4"
  }
}
