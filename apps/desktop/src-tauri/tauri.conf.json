{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurevoy",
  "version": "0.5.0-dev",
  "identifier": "com.aurevoy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aurevoy",
        "width": 1000,
        "height": 720,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../agent/dist": "agent-dist",
      "../../agent/package.json": "agent-pkg",
      "../../agent/node_modules": "agent-dist/node_modules",
      "../../agent/skills/builtin": "skills/builtin",
      "node-runtime": "node-runtime"
    }
  }
}
